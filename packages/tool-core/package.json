{
  "name": "@agent-page/tool-core",
  "version": "0.5.0",
  "description": "Shared Agent Page Protocol tool runtime (session store, digest, holds, envelope)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
