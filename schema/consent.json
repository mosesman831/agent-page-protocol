{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "consent.json",
  "title": "Consent state value (logical; wire form is object StateNode at state.consent)",
  "type": "object",
  "required": ["version", "required", "purposes"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "required": { "type": "boolean" },
    "purposes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "granted", "required"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(necessary|functional|analytics|marketing|personalization|sharing_third_party|x_[a-z0-9_]+)$"
          },
          "granted": { "type": "boolean" },
          "required": { "type": "boolean" },
          "label": { "type": "string", "maxLength": 200 },
          "retention_days": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
