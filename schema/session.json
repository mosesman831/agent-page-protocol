{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.json",
  "title": "Session state value (logical; wire form is object StateNode at state.session)",
  "type": "object",
  "required": ["status"],
  "additionalProperties": true,
  "properties": {
    "status": {
      "enum": ["anonymous", "pending_mfa", "pending_consent", "authenticated", "expired", "locked"]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_at": {
      "type": "string",
      "format": "date-time"
    },
    "has_access_token": {
      "type": "boolean"
    },
    "has_resume_token": {
      "type": "boolean"
    },
    "subject_ref": {
      "type": "string",
      "maxLength": 128
    },
    "scopes": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "maxLength": 128
      }
    }
  }
}
